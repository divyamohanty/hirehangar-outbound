# Everything here is OPTIONAL. With no keys, `python3 -m hh demo` runs the full pipeline for $0.
# Bring your own keys (BYOK): copy to .env and fill in only what you use. .env is git-ignored.

# --- Resume parsing (small LLM, fixed JSON) ---
# rules = free regex parser | anthropic | openai (any OpenAI-compatible server, e.g. local Ollama = free)
HH_LLM_PROVIDER=rules
ANTHROPIC_API_KEY=
HH_ANTHROPIC_MODEL=claude-haiku-5-5
HH_OPENAI_BASE_URL=http://localhost:11434/v1
HH_OPENAI_API_KEY=ollama
HH_OPENAI_MODEL=llama3.1:8b
# salt for the applicant dedupe hash (set a long random string in production)
HH_HASH_SALT=change-me

# --- treg (people search, work email find + verify, web search for triggers) ---
# No key here: run `treg login` once. Hard cap on spend per enrich run:
HH_TREG_MAX_SPEND_USD=0.50

# --- Optional upgrades (not required by any command today) ---
# EXA_API_KEY=        # Exa Websets: lookalikes of your best clients
# PARALLEL_API_KEY=   # Parallel Monitor: funding + new-leader triggers
# INSTANTLY_API_KEY=  # push leads by API instead of CSV import
# HEYREACH_API_KEY=
# HUBSPOT_TOKEN=
